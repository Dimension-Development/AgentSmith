# --- Local Supabase (Docker) — recommended for development ---
# 1. npm run db:start
# 2. npm run db:env   # overwrites .env.local with keys from `supabase status`
#
# Defaults below match the public local demo keys (safe for local only).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Server-only (optional for Phase 1 UI; required for some scripts / Phase 2)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Hosted Supabase (staging / production) ---
# Replace the three values above with Project Settings → API from the dashboard.
# Apply migrations: supabase link --project-ref <ref> && npm run db:push
# Auth → URL config: Site URL + redirect http(s)://<host>/auth/callback
